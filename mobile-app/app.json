{
  "expo": {
    "name": "MyJantes",
    "slug": "myjantes",
    "owner": "replit-private-68ce2c4f-d424-4543-9036-38cb79ace0aa",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "myjantes",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#dc2626"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.myjantes.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:app.myjantes.fr",
        "applinks:myjantes.fr",
        "webcredentials:app.myjantes.fr"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "MyJantes utilise l'appareil photo pour prendre des photos de vos jantes lors d'une demande de devis ou pour l'essai en réalité augmentée.",
        "NSPhotoLibraryUsageDescription": "MyJantes accède à vos photos pour joindre des images à vos demandes de devis et pour l'essai en réalité augmentée.",
        "NSPhotoLibraryAddUsageDescription": "MyJantes enregistre dans votre photothèque les visuels d'essai en réalité augmentée que vous souhaitez partager.",
        "NSLocationWhenInUseUsageDescription": "MyJantes utilise la localisation pour vous proposer le garage le plus proche.",
        "NSUserNotificationsUsageDescription": "MyJantes vous envoie des notifications pour suivre l'avancement de vos devis, factures et rendez-vous.",
        "NSUserTrackingUsageDescription": "MyJantes n'utilise pas vos données à des fins publicitaires. Aucun pistage n'est effectué.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.myjantes.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dc2626"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.myjantes.fr",
              "pathPrefix": "/public/devis/"
            },
            {
              "scheme": "https",
              "host": "app.myjantes.fr",
              "pathPrefix": "/public/facture/"
            },
            {
              "scheme": "https",
              "host": "app.myjantes.fr",
              "pathPrefix": "/public/reservation/"
            },
            {
              "scheme": "https",
              "host": "app.myjantes.fr",
              "pathPrefix": "/public/avis/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "myjantes"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#dc2626",
          "sounds": []
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.fr.myjantes.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "43ff8e7d-523b-4909-8d18-f36c34990341"
      }
    }
  }
}
